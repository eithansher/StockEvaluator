# Copy to .env (git-ignored). Never commit real values.

# SEC requires automated clients to declare who they are before it serves filing documents.
# Without this, XBRL facts still load and verdicts work, but filing text (management quotes) is skipped.
SEC_USER_AGENT=Your Name your.email@school.edu

# Optional: enables the Claude planner and assessor (model claude-sonnet-5-5). Without it the
# rule-based planner is used. STT_PLANNER=rules forces the offline planner.
ANTHROPIC_API_KEY=
